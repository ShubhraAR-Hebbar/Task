# ==============================================================================
# Real-Time Pricing Engine - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your .env file or real secrets to version control.
# ==============================================================================

# External Market Data Feed
EXTERNAL_WS_URL=wss://v3-prod.livefxhub.com/ws/algo
API_KEY=your_public_api_key_here
API_SECRET=your_secret_key_here

# Comma-separated list of symbols to subscribe to from external provider
SUBSCRIBE_SYMBOLS=EURUSD,GBPUSD,USDJPY,BTCUSD,ETHUSD

# External WebSocket Connection Resilience
EXTERNAL_WS_RECONNECT_INITIAL_DELAY=1.0
EXTERNAL_WS_RECONNECT_MAX_DELAY=60.0
EXTERNAL_WS_TIMEOUT_SECONDS=10.0

# Outbound Client WebSocket Server
OUTBOUND_WS_HOST=0.0.0.0
OUTBOUND_WS_PORT=8765
CLIENT_QUEUE_MAXSIZE=1000

# Market Data Calculation & Windowing
WINDOW_SECONDS=86400
PRICE_SPIKE_THRESHOLD_PCT=50.0

# State Persistence & Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_ENABLED=true
REDIS_RETRY_INTERVAL_SECONDS=5.0
REDIS_RETENTION_SECONDS=90000

# Observability & Logging
LOG_LEVEL=INFO
METRICS_REPORT_INTERVAL_SECONDS=10.0
